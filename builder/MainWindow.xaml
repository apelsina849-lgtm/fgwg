<Window x:Class="CRPLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CRP Launcher" WindowStartupLocation="CenterScreen"
        WindowStyle="None" WindowState="Maximized" ResizeMode="CanResize"
        Background="#05080E" Foreground="White" FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#22D4FF" Offset="0"/>
            <GradientStop Color="#0887FF" Offset="0.55"/>
            <GradientStop Color="#7457FF" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="16" Padding="18,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.90"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.74"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="46"/>
        </Style>
        <Style x:Key="CustomProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Background" Value="#162638"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="7" Background="{TemplateBinding Foreground}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#12CFFF" BlurRadius="16" ShadowDepth="0" Opacity="0.85"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Image x:Name="HeroImage" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#10000000" Offset="0"/>
                    <GradientStop Color="#56040A12" Offset="0.55"/>
                    <GradientStop Color="#DB05080E" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#26000000" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <TextBlock Text="CRP LAUNCHER" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="22,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="54" Content="—" FontSize="18" Foreground="White" Background="Transparent" BorderThickness="0" Click="Minimize_Click"/>
                    <Button Width="54" Content="✕" FontSize="17" Foreground="White" Background="#22FFFFFF" BorderThickness="0" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="500"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="56" Padding="24" Background="#8A050A13" CornerRadius="20" MaxWidth="760">
                    <StackPanel>
                        <TextBlock Text="CENTER ROLE PLAY" FontSize="44" FontWeight="Black"/>
                        <TextBlock Text="CRP LAUNCHER 1.5" FontSize="18" Foreground="#AEE6FF" Margin="0,3,0,12"/>
                        <TextBlock Text="Полноэкранная загрузка • обязательная проверка файлов • установка CRP • MoonLoader" FontSize="16" Foreground="#E7F4FF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#E50A111C" Padding="32">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="ЛАУНЧЕР" FontSize="36" FontWeight="Black"/>
                            <TextBlock Text="Файлы проверяются автоматически при каждом запуске" FontSize="14" Foreground="#9DB1C6" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,28,0,0">
                            <TextBlock Text="Папка GTA San Andreas" FontSize="13" Foreground="#9DB1C6"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="GamePathBox" Height="44" Padding="12,10" Background="#121D2A" Foreground="White" BorderBrush="#29415C" BorderThickness="1" FontSize="13" LostFocus="GamePathBox_LostFocus"/>
                                <Button Grid.Column="1" x:Name="BrowseButton" Content="ОБЗОР" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="BrowseButton_Click"/>
                            </Grid>
                            <TextBlock Text="Ник" FontSize="13" Foreground="#9DB1C6" Margin="0,18,0,0"/>
                            <TextBox x:Name="NickBox" Height="44" Padding="12,10" Margin="0,8,0,0" Background="#121D2A" Foreground="White" BorderBrush="#29415C" BorderThickness="1" FontSize="14" MaxLength="24" LostFocus="NickBox_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,26,0,0">
                            <Grid>
                                <TextBlock x:Name="StatusText" Text="Подготовка..." FontSize="14" Foreground="#E4F1FF"/>
                                <TextBlock x:Name="PercentText" Text="0%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#68D8FF"/>
                            </Grid>
                            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" Margin="0,10,0,0" Style="{StaticResource CustomProgress}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4">
                            <Button x:Name="MainButton" Content="ПРОВЕРКА..." Style="{StaticResource ActionButton}" Click="MainButton_Click" IsEnabled="False"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="ModsButton" Grid.Column="0" Content="МОДЫ / MOONLOADER" Style="{StaticResource SmallButton}" Background="#193047" Margin="0,0,6,0" Click="ModsButton_Click"/>
                                <Button x:Name="VerifyButton" Grid.Column="1" Content="ПРОВЕРИТЬ ФАЙЛЫ" Style="{StaticResource SmallButton}" Background="#193047" Margin="6,0,0,0" Click="VerifyButton_Click"/>
                            </Grid>
                            <TextBlock Text="CRP • 188.127.241.8:1154" HorizontalAlignment="Center" Foreground="#6E8499" FontSize="12" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Grid x:Name="ModsOverlay" Visibility="Collapsed" Background="#D9000000">
            <Border Width="590" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#0D1622" BorderBrush="#2B4C68" BorderThickness="1" CornerRadius="22" Padding="30">
                <StackPanel>
                    <TextBlock Text="МОДЫ" FontSize="34" FontWeight="Black"/>
                    <TextBlock Text="MoonLoader + библиотеки для Lua-модов" Foreground="#9EB2C7" FontSize="14" Margin="0,4,0,20"/>
                    <Border Background="#132131" CornerRadius="14" Padding="17">
                        <StackPanel>
                            <TextBlock x:Name="MoonStatus" Text="Статус: проверка..." FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Устанавливается MoonLoader и набор совместимых библиотек. Основные CRP-файлы не заменяются без необходимости." TextWrapping="Wrap" Foreground="#96ABC0" FontSize="13" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="InstallMoonButton" Content="УСТАНОВИТЬ MOONLOADER" Style="{StaticResource ActionButton}" Margin="0,20,0,0" Click="InstallMoonButton_Click"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="OpenMoonFolderButton" Grid.Column="0" Content="ОТКРЫТЬ ПАПКУ" Style="{StaticResource SmallButton}" Background="#193047" Margin="0,0,6,0" Click="OpenMoonFolderButton_Click"/>
                        <Button x:Name="CloseModsButton" Grid.Column="1" Content="ЗАКРЫТЬ" Style="{StaticResource SmallButton}" Background="#193047" Margin="6,0,0,0" Click="CloseModsButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
